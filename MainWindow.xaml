<Window x:Class="Labs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Labs"
        mc:Ignorable="d"
        Title="TextEditor" Height="300" Width="500">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="25*"></RowDefinition>
            <RowDefinition Height="117*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal" Height="50" Width="200">
            <Button Width="50">
                <Image Source="Image/open_img.png"/>
            </Button>
            <Button Width="50">
                <Image Source="Image/delete_img.png"/>
            </Button>
            <Button Width="50">
                <Image Source="Image/copy_img.png"/>
            </Button>
            <Button Width="50">
                <Image Source="Image/paste_img.png"/>
            </Button>
        </StackPanel>
        <Border Grid.Row="0" BorderBrush="#FFCBBEBE" BorderThickness="2" CornerRadius="10"></Border>
        <Border BorderBrush="#FFCBBEBE" BorderThickness="2" CornerRadius="10" Margin="0,50,0,0" Grid.RowSpan="2"/>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="100*"></RowDefinition>
                <RowDefinition Height="20*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <ScrollViewer>
                <TextBox Grid.Row="0"></TextBox>
            </ScrollViewer>
            <Button Grid.Row="1" Width="20" Height="20" Content="OK"></Button>
            <DockPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"></DockPanel>

        </Grid>

    </Grid>

</Window>
