<Window x:Class="Labs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Labs"
        Title="Хрестики-нулики"
        MinWidth="360" MinHeight="480"
        Width="420"   Height="540"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2E">

    <Window.Resources>

        <local:GameViewModel x:Key="VM"/>

        <local:SymbolColorConverter x:Key="ColorConv"/>

        <Style x:Key="CellStyle" TargetType="Button">
            <Setter Property="FontSize"           Value="48"/>
            <Setter Property="FontWeight"         Value="Bold"/>
            <Setter Property="Margin"             Value="6"/>
            <Setter Property="Cursor"             Value="Hand"/>
            <Setter Property="BorderThickness"    Value="0"/>
            <Setter Property="Focusable"          Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="16"
                                Background="#16213E"
                                BorderThickness="2"
                                BorderBrush="#0F3460">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F3460"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E94560"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E94560"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RestartStyle" TargetType="Button">
            <Setter Property="FontSize"        Value="16"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Background"      Value="#E94560"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="24,10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#c73652"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#a02840"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScoreLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#A8DADC"/>
            <Setter Property="FontSize"    Value="14"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ScoreValue" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontSize"    Value="26"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid DataContext="{StaticResource VM}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>
            
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="✕  О"
                   FontSize="36" FontWeight="Black"
                   Foreground="White"
                   TextAlignment="Center"
                   Margin="0,20,0,8"/>

        <Grid Grid.Row="1" Margin="20,4,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Гравець X" Style="{StaticResource ScoreLabel}" Foreground="#4FC3F7"/>
                <TextBlock Text="{Binding ScoreX}" Style="{StaticResource ScoreValue}" Foreground="#4FC3F7"/>
            </StackPanel>

            <Rectangle Grid.Column="1" Width="1" Fill="#333" Margin="0,4"/>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Нічиї" Style="{StaticResource ScoreLabel}"/>
                <TextBlock Text="{Binding Draws}"  Style="{StaticResource ScoreValue}"/>
            </StackPanel>

            <Rectangle Grid.Column="3" Width="1" Fill="#333" Margin="0,4"/>

            <StackPanel Grid.Column="4">
                <TextBlock Text="Гравець O" Style="{StaticResource ScoreLabel}" Foreground="#EF9A9A"/>
                <TextBlock Text="{Binding ScoreO}" Style="{StaticResource ScoreValue}" Foreground="#EF9A9A"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="2"
                     Rows="3" Columns="3"
                     Margin="16,0">

            <Button Style="{StaticResource CellStyle}"
                    Command="{Binding MakeMoveCommand, Source={StaticResource VM}}"
                    CommandParameter="0">
                <TextBlock Text="{Binding C0, Source={StaticResource VM}}"
                           Foreground="{Binding C0, Source={StaticResource VM},
                                        Converter={StaticResource ColorConv}}"/>
            </Button>

            <Button Style="{StaticResource CellStyle}"
                    Command="{Binding MakeMoveCommand, Source={StaticResource VM}}"
                    CommandParameter="1">
                <TextBlock Text="{Binding C1, Source={StaticResource VM}}"
                           Foreground="{Binding C1, Source={StaticResource VM},
                                        Converter={StaticResource ColorConv}}"/>
            </Button>

            <Button Style="{StaticResource CellStyle}"
                    Command="{Binding MakeMoveCommand, Source={StaticResource VM}}"
                    CommandParameter="2">
                <TextBlock Text="{Binding C2, Source={StaticResource VM}}"
                           Foreground="{Binding C2, Source={StaticResource VM},
                                        Converter={StaticResource ColorConv}}"/>
            </Button>

            <Button Style="{StaticResource CellStyle}"
                    Command="{Binding MakeMoveCommand, Source={StaticResource VM}}"
                    CommandParameter="3">
                <TextBlock Text="{Binding C3, Source={StaticResource VM}}"
                           Foreground="{Binding C3, Source={StaticResource VM},
                                        Converter={StaticResource ColorConv}}"/>
            </Button>

            <Button Style="{StaticResource CellStyle}"
                    Command="{Binding MakeMoveCommand, Source={StaticResource VM}}"
                    CommandParameter="4">
                <TextBlock Text="{Binding C4, Source={StaticResource VM}}"
                           Foreground="{Binding C4, Source={StaticResource VM},
                                        Converter={StaticResource ColorConv}}"/>
            </Button>

            <Button Style="{StaticResource CellStyle}"
                    Command="{Binding MakeMoveCommand, Source={StaticResource VM}}"
                    CommandParameter="5">
                <TextBlock Text="{Binding C5, Source={StaticResource VM}}"
                           Foreground="{Binding C5, Source={StaticResource VM},
                                        Converter={StaticResource ColorConv}}"/>
            </Button>

            <Button Style="{StaticResource CellStyle}"
                    Command="{Binding MakeMoveCommand, Source={StaticResource VM}}"
                    CommandParameter="6">
                <TextBlock Text="{Binding C6, Source={StaticResource VM}}"
                           Foreground="{Binding C6, Source={StaticResource VM},
                                        Converter={StaticResource ColorConv}}"/>
            </Button>

            <Button Style="{StaticResource CellStyle}"
                    Command="{Binding MakeMoveCommand, Source={StaticResource VM}}"
                    CommandParameter="7">
                <TextBlock Text="{Binding C7, Source={StaticResource VM}}"
                           Foreground="{Binding C7, Source={StaticResource VM},
                                        Converter={StaticResource ColorConv}}"/>
            </Button>

            <Button Style="{StaticResource CellStyle}"
                    Command="{Binding MakeMoveCommand, Source={StaticResource VM}}"
                    CommandParameter="8">
                <TextBlock Text="{Binding C8, Source={StaticResource VM}}"
                           Foreground="{Binding C8, Source={StaticResource VM},
                                        Converter={StaticResource ColorConv}}"/>
            </Button>

        </UniformGrid>

        <StackPanel Grid.Row="3" Margin="20,12,20,20" HorizontalAlignment="Center">
            <TextBlock Text="{Binding StatusText, Source={StaticResource VM}}"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="#FFD700"
                       TextAlignment="Center"
                       Margin="0,0,0,12"/>

            <Button Style="{StaticResource RestartStyle}"
                    Content="🔄  Нова гра"
                    Command="{Binding RestartCommand, Source={StaticResource VM}}"/>
        </StackPanel>
    </Grid>
</Window>
